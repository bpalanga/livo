
# JWT signing secret. This must be a long, random, unguessable string —
# generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NEVER commit your real value; this file only ships a placeholder.
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_STRING"

# Google Sign-In: create an OAuth 2.0 Client ID at
# https://console.cloud.google.com/apis/credentials (Web application type,
# with http://localhost:3000 as an authorized JavaScript origin).
# Use the SAME client ID for both of these values.
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"

APP_URL="MY_APP_URL"
